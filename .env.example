# --- Web app ---
PORT=5000
CACHE_REFRESH_MINUTES=30
EPICS_ONLY=false           # true: dashboards count only cards labelled 'Type: Epic'

# --- Trello (required) ---
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=

# --- LLM: Gemini (optional; if unset, a template-based draft is produced) ---
GOOGLE_API_KEY=
# LLM_MODEL=gemini-3.8-flash   # default

# --- Email sending (optional; if empty, approved reports are saved to ./reports) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_FROM=
REPORT_TO=

# --- Scheduler ---
SCHEDULER_TZ=UTC
WEEKLY_CRON=0 9 * * fri
REMINDER_CRON=0 9 * * mon-fri
SCHEDULE_SEND=false
LOOKBACK_DAYS=7
PROJECT_NAME=My Project
SLACK_WEBHOOK_URL=
